# Sinh secret ngẫu nhiên >=32 ký tự; dùng CÙNG giá trị với backend chatbot.
# Không commit file .env thật. Token API→MCP sống tối đa 300 giây.
ASSISTANT_MCP_SECRET=replace-with-a-random-secret-at-least-32-characters
# Đường dẫn tương đối được tính từ working directory khi chạy service.
ASSISTANT_ACADEMIC_DB=data/academic.sqlite3
# Khi triển khai container, chỉ thêm hostname/origin nội bộ cần dùng.
ASSISTANT_MCP_ALLOWED_HOSTS=["127.0.0.1:*", "localhost:*"]
ASSISTANT_MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*", "http://localhost:*"]
